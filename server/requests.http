###
### Health check (should say "API is running") (200)
GET http://localhost:3000

###
### Get all tickets (200)
GET http://localhost:3000/api/tickets

###
### Get one ticket (200)
GET http://localhost:3000/api/tickets/6af81da776b5053064f021b3

###
### Get one ticket that doesn't exist (404)
GET http://localhost:3000/api/tickets/99

### Get only open tickets
GET http://localhost:3000/api/tickets?status=open

### Get only closed tickets
GET http://localhost:3000/api/tickets?status=closed

###
### Create a ticket (201)
POST http://localhost:3000/api/tickets
Content-Type: application/json

{
    "title": "Mouse not working",
    "description": "My mouse stopped clicking",
    "priority": "low",
    "category": "hardware"
}

###
### Update a ticket's status (200)
PATCH http://localhost:3000/api/tickets/6af4131552c2c8238de1ce9d
Content-Type: application/json

{
    "status": "closed"
}

### Update a ticket that doesn't exist (404)
PATCH http://localhost:3000/api/tickets/99
Content-Type: application/json

{
    "status": "closed"
}

### Delete a ticket (200)
DELETE http://localhost:3000/api/tickets/6af81da776b5053064f021b3

### Delete a ticket that doesn't exist (404)
DELETE http://localhost:3000/api/tickets/99




######################################################################
######################################################################
######################################################################




### Create a ticket with no title (400)
POST http://localhost:3000/api/tickets
Content-Type: application/json

{
    "description": "No title here",
    "priority": "low",
    "category": "hardware"
}

### Create a ticket with only spaces as the title (400)
POST http://localhost:3000/api/tickets
Content-Type: application/json

{
    "title": "  ",
    "description": "Spaces only",
    "priority": "low",
    "category": "hardware"
}

### Update with an invalid status (400)
PATCH http://localhost:3000/api/tickets/6af4131552c2c8238de1ce9d
Content-Type: application/json

{
    "status": "banana"
}



######################################################################
######################################################################
######################################################################



### Register a new user (should be 201)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
    "name": "Test User",
    "email": "test@example.com",
    "password": "testpassword123"
}

### Register the same email again (should be 409)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
    "name": "Test User",
    "email": "test@example.com",
    "password": "testpassword123"
}

### Register with a short password (should be 400)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
    "name": "Short",
    "email": "short@example.com",
    "password": "123"
}

### Register with missing fields (should be 400)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
    "email": "missing@example.com"
}



######################################################################
######################################################################
######################################################################


### Login (should be 200 with a token)
# @name login
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "testpassword123"
}

### Login with the wrong password (should be 401)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "wrongpassword"
}

### Login with an email that doesn't exist (should be 401)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
    "email": "nobody@example.com",
    "password": "testpassword123"
}



######################################################################
######################################################################
######################################################################



### Create a ticket WITHOUT a keycard (should be 401)
POST http://localhost:3000/api/tickets
Content-Type: application/json

{
    "title": "No keycard",
    "description": "This should be blocked",
    "priority": "low",
    "category": "hardware"
}

### Create a ticket WITH a keycard (should be 201)
POST http://localhost:3000/api/tickets
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "title": "With keycard",
    "description": "This should work",
    "priority": "low",
    "category": "hardware"
}
