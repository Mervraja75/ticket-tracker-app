###
### Health check (should say "API is running") (200)
GET http://localhost:3000

###
### Get all tickets (200)
GET http://localhost:3000/api/tickets

###
### Create a ticket (201)
POST http://localhost:3000/api/tickets
Content-Type: application/json

{
    "title": "Mouse not working",
    "description": "My mouse stopped clicking",
    "priority": "low",
    "category": "hardware"
}

###
### Get one ticket (200)
GET http://localhost:3000/api/tickets/1

###
### Get one ticket that doesn't exist (404)
GET http://localhost:3000/api/tickets/99

###
### Update a ticket's status (200)
PATCH http://localhost:3000/api/tickets/1
Content-Type: application/json

{
    "status": "closed"
}

### Update a ticket that doesn't exist (404)
PATCH http://localhost:3000/api/tickets/99
Content-Type: application/json

{
    "status": "closed"
}

### Delete a ticket (200)
DELETE http://localhost:3000/api/tickets/1793948742284

### Delete a ticket that doesn't exist (404)
DELETE http://localhost:3000/api/tickets/99

######################################################################

### Create a ticket with no title (400)
POST http://localhost:3000/api/tickets
Content-Type: application/json

{
    "description": "No title here",
    "priority": "low",
    "category": "hardware"
}

### Create a ticket with only spaces as the title (400)
POST http://localhost:3000/api/tickets
Content-Type: application/json

{
    "title": "  ",
    "description": "Spaces only",
    "priority": "low",
    "category": "hardware"
}

### Update with an invalid status (400)
PATCH http://localhost:3000/api/tickets/1
Content-Type: application/json

{
    "status": "banana"
}
